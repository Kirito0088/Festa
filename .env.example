# Frontend (.env.local). `npx convex dev` writes these for local development.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Backend secrets live only in Convex environment variables, never in this file:
#   npx convex env set GROQ_API_KEY      # free Groq key; without it Festa uses its built-in planner
#   npx convex env set GROQ_MODEL        # optional, defaults to openai/gpt-oss-120b
#   npx convex env set GROQ_FALLBACK_MODEL  # optional, defaults to openai/gpt-oss-20b
#   npx convex env set JWT_PRIVATE_KEY   # Convex Auth signing key
#   npx convex env set JWKS              # Convex Auth public key set
#   npx convex env set SITE_URL          # the app's public URL
